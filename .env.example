# Copy this file to ".env" (exact name). No Google Maps key is needed any more.

# Optional but recommended: your email or website. OpenStreetMap services ask apps to identify themselves.
OSM_CONTACT=

# Optional, FREE: Gemini key for the "Ask BREWZA AI" box. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# If you see a "model not available" message, pick a free-tier model listed in Google AI Studio and put it here.
GEMINI_MODEL=gemini-2.5-flash
